<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>CalmCombo</name>
  <version>1.0.0</version>
  <platform>cd</platform>
  <makefile>Makefile</makefile>
  <neocorePath>..\neocore</neocorePath>
  <buildPath>..\build</buildPath>
  <distPath>..\dist</distPath>
  <gfx>
    <DAT>
      <chardata>
        <!-- DO NOT EDIT : setup -->
        <setup>
          <starting_tile>256</starting_tile>
          <charfile>out\char.bin</charfile>
          <mapfile>out\charMaps.s</mapfile>
          <palfile>out\charPals.s</palfile>
          <incfile>out\charInclude.h</incfile>
          <incprefix>../</incprefix>
        </setup>
        <pict id="cc_logo">
          <file>assets\gfx\logo.png</file>
        </pict>
        <pict id="cc_tiles">
          <file>assets\gfx\board\tiles.png</file>
        </pict>
        <pict id="cc_cursor">
          <file>assets\gfx\board\cursor.png</file>
        </pict>
        <pict id="cc_panel">
          <file>assets\gfx\board\panel.png</file>
        </pict>
        <!-- scenery (milestone 3): every frame of every scene loads once at boot -->
        <pict id="cc_sun">
          <file>assets\gfx\common\sun.png</file>
        </pict>
        <pict id="cc_moon">
          <file>assets\gfx\common\moon.png</file>
        </pict>
        <pict id="cc_lake_sky">
          <file>assets\gfx\lake\sky.png</file>
        </pict>
        <pict id="cc_ridge_mid">
          <file>assets\gfx\lake\ridge_mid.png</file>
        </pict>
        <pict id="cc_ridge_near">
          <file>assets\gfx\lake\ridge_near.png</file>
        </pict>
        <pict id="cc_water">
          <file>assets\gfx\lake\water.png</file>
        </pict>
        <pict id="cc_firefly">
          <file>assets\gfx\lake\firefly.png</file>
        </pict>
        <pict id="cc_sky_sea">
          <file>assets\gfx\beach\sky_sea.png</file>
        </pict>
        <pict id="cc_glitter">
          <file>assets\gfx\beach\glitter.png</file>
        </pict>
        <pict id="cc_shore">
          <file>assets\gfx\beach\shore.png</file>
        </pict>
        <pict id="cc_palm">
          <file>assets\gfx\beach\palm.png</file>
        </pict>
        <pict id="cc_umbrella">
          <file>assets\gfx\beach\umbrella.png</file>
        </pict>
        <pict id="cc_city">
          <file>assets\gfx\window\city.png</file>
        </pict>
        <pict id="cc_rain">
          <file>assets\gfx\window\rain.png</file>
        </pict>
        <pict id="cc_droplet">
          <file>assets\gfx\window\droplet.png</file>
        </pict>
        <pict id="cc_frame">
          <file>assets\gfx\window\frame.png</file>
        </pict>
        <pict id="cc_steam">
          <file>assets\gfx\window\steam.png</file>
        </pict>
      </chardata>
      <fixdata>
        <chardata>
          <!-- DO NOT EDIT : setup -->
          <setup fileType="fix">
            <charfile>out\fix.bin</charfile>
            <palfile>out\fixPals.s</palfile>
            <incfile>out\fixData.h</incfile>
          </setup>
          <import bank="0">
            <file>{{build}}\fix\systemFont.bin</file>
          </import>
          <!-- The next free bank is bank 3 -->
          <fix bank="3" id="cc_font">
            <file>assets\gfx\font\font.png</file>
          </fix>
        </chardata>
      </fixdata>
    </DAT>
  </gfx>
  <!-- To use CDDA audio tracks, uncomment and set up your files.
  Warning: Track ID 1 is reserved for the binary program.
  <sound>
    <cd>
      <sfx>
        <pcm>assets\sounds\sfx\click.V1</pcm>
        <z80>assets\sounds\sfx\click.M1</z80>
      </sfx>
      <cdda>
        <dist>
          <iso>
            <format>mp3</format>
          </iso>
        </dist>
        <tracks>
          <track>
            <id>2</id>
            <file>assets\sounds\cdda\track_1.mp3</file>
            <pregap>00:02:00</pregap>
          </track>
        </tracks>
      </cdda>
    </cd>
  </sound> -->
  <emulator>
    <raine>
        <!-- DO NOT EDIT: This exeFile path is automatically maintained by NeoCore -->
      <exeFile>{{build}}\raine\raine.exe</exeFile>
      <config>
        <!-- To use a named config, use mak run:raine:<configName>.
        Example: mak run:raine:full to run RAINE in fullscreen.
        You can add more custom configs. -->
        <default>{{build}}\raine\config\default.cfg</default>
        <full>{{build}}\raine\config\fullscreen.cfg</full>
      </config>
    </raine>
    <mame>
      <exeFile>{{build}}\mame\mame64.exe</exeFile>
      <profile>
        <!-- To use a named profile, use mak run:mame:<profileName>.
        Example: mak run:mame:full to run MAME in fullscreen.
        You can add more custom profiles. -->
        <default>-window -skip_gameinfo neocdz</default>
        <full>-nowindow -skip_gameinfo neocdz</full>
        <nosound>-sound none -window -skip_gameinfo neocdz</nosound>
        <!-- DO NOT EDIT: This debug profile is automatically maintained by NeoCore -->
        <debug>-console -debug -window -skip_gameinfo -pluginspath {{build}}\mame\plugins -plugin ngdev neocdz</debug>
      </profile>
    </mame>
  </emulator>
  <compiler>
    <path>{{build}}\gcc\gcc-2.95.2</path>
    <includePath>{{neocore}}\src-lib\include</includePath>
    <libraryPath>{{build}}\lib</libraryPath>
    <crtPath>{{neocore}}\src-lib\crt</crtPath>
    <systemFile>
      <cd>{{neocore}}\src-lib\system\neocd.x</cd>
      <cartridge>{{neocore}}\src-lib\system\neocart.x</cartridge>
    </systemFile>
  </compiler>
</project>